{
    "semi": false,
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "endOfLine": "auto",
    "overrides": [
        {
            "files": "**/*.{json,jsonc,json5}",
            "options": {
                "printWidth": 80,
                "trailingComma": "none"
            }
        },
        {
            "files": "**/*.{yml,yaml,md,mdx,toml}",
            "options": {
                "printWidth": 80,
                "trailingComma": "none"
            }
        }
    ]
}
