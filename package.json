{
    "name": "@oliverperzyk/plot-addon",
    "description": "A plot addon for a SMP-like server.",
    "version": "0.0.1",
    "private": true,
    "license": "AGPL-3.0",
    "homepage": "https://oliverperzyk.com",
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/plot-addon.git"
    },
    "bugs": {
        "url": "https://github.com/oliverperzyk/plot-addon/issues"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3"
    },
    "scripts": {
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "lint": "bunx eslint .",
        "lint:fix": "bunx eslint --fix .",
        "build": "bedrock-build build",
        "watch": "bedrock-build watch",
        "deploy": "bedrock-build deploy",
        "deploy:watch": "bedrock-build deploy --watch",
        "pack": "bedrock-build pack",
        "release": "bedrock-build build --release"
    },
    "dependencies": {
        "@minecraft/server": "^2.9.0",
        "@minecraft/server-ui": "^2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@keyyard/bedrock-build": "^3.0.0",
        "eslint": "^10.9.0",
        "globals": "^17.11.0",
        "jiti": "^2.7.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0"
    }
